    {
      "id": "abode-local-mapping-body",
      "type": "text",
      "x": 1791.26953125,
      "y": 3730.42578125,
      "width": 530,
      "height": 403.75,
      "angle": 0,
      "strokeColor": "#334155",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 920002,
      "version": 4,
      "versionNonce": 1199380089,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1792242393208,
      "link": null,
      "locked": false,
      "text": "Decode names relative to this device home:\ndot_config/nvim -> .config/nvim\ndot_zshrc -> .zshrc\n\nDirectory child:\n~/.config/nvim/lua/plugins.lua\n  <-> ~/.local/share/abode/dot_config/nvim/lua/plugins.lua\n\nSingle file:\n~/.config/kitty/kitty.conf\n  <-> ~/.local/share/abode/dot_config/kitty/kitty.conf\n\nUse the same mapping in capture and apply.\nSelect decoded relative paths locally.\nNo generated root IDs or fallback metadata.\nOutside-home mappings are deferred.\nNames encode attributes; bytes stay original.",
      "originalText": "Decode names relative to this device home:\ndot_config/nvim -> .config/nvim\ndot_zshrc -> .zshrc\n\nDirectory child:\n~/.config/nvim/lua/plugins.lua\n  <-> ~/.local/share/abode/dot_config/nvim/lua/plugins.lua\n\nSingle file:\n~/.config/kitty/kitty.conf\n  <-> ~/.local/share/abode/dot_config/kitty/kitty.conf\n\nUse the same mapping in capture and apply.\nSelect decoded relative paths locally.\nNo generated root IDs or fallback metadata.\nOutside-home mappings are deferred.\nNames encode attributes; bytes stay original.",
      "fontSize": 17,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": false,
      "lineHeight": 1.25,
      "index": "c062z"
    },
