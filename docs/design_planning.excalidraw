    {
      "id": "abode-github-conflicts-body",
      "type": "text",
      "x": 511.26953125,
      "y": 3730.42578125,
      "width": 530,
      "height": 360,
      "angle": 0,
      "strokeColor": "#334155",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
