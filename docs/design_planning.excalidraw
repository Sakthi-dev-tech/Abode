      "updated": 1792242393208,
      "link": null,
      "locked": false,
      "text": "~/.config/abode/\n  config.toml       # remote + selected paths\n~/.local/state/abode/\n  state.json        # revisions/hashes by path\n                    # apply journal + conflicts\n~/.local/share/abode/ # managed Git source tree\n  .git/             # history + pending refs\n  dot_config/\n    nvim/\n      init.lua\n      lua/plugins.lua\n    kitty/\n      kitty.conf\n  dot_zshrc\n\nAbode's data directory mirrors GitHub.\nConfig and state stay outside the repository.\nInit/verify use the data directory directly.",
      "originalText": "~/.config/abode/\n  config.toml       # remote + selected paths\n~/.local/state/abode/\n  state.json        # revisions/hashes by path\n                    # apply journal + conflicts\n~/.local/share/abode/ # managed Git source tree\n  .git/             # history + pending refs\n  dot_config/\n    nvim/\n      init.lua\n      lua/plugins.lua\n    kitty/\n      kitty.conf\n  dot_zshrc\n\nAbode's data directory mirrors GitHub.\nConfig and state stay outside the repository.\nInit/verify use the data directory directly.",
      "fontSize": 17,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": false,
      "lineHeight": 1.25,
