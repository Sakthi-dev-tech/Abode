      "seed": 920000,
      "version": 3,
      "versionNonce": 1669796825,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1792041357296,
      "link": null,
      "locked": false,
      "text": "Conflict detected during reconciliation\n  -> preserve the actual file unchanged\n  -> retain base/local/remote in local Git refs\n  -> persist conflict state across restarts\n  -> alert the user on this device\n\nUser chooses local, remote or edited contents.\nUse a local editor or merge tool as needed.\nQueue the resolved result for the next cycle.\nFetch again; recheck local and remote edits.\nIf either side diverged, reconcile again.\n\nPublish resolved contents with a normal push.\nThen safely apply and checkpoint each file.\nPause affected files; continue safe files.\nUnresolved contents stay off the shared branch.",
      "originalText": "Conflict detected during reconciliation\n  -> preserve the actual file unchanged\n  -> retain base/local/remote in local Git refs\n  -> persist conflict state across restarts\n  -> alert the user on this device\n\nUser chooses local, remote or edited contents.\nUse a local editor or merge tool as needed.\nQueue the resolved result for the next cycle.\nFetch again; recheck local and remote edits.\nIf either side diverged, reconcile again.\n\nPublish resolved contents with a normal push.\nThen safely apply and checkpoint each file.\nPause affected files; continue safe files.\nUnresolved contents stay off the shared branch.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": false,
      "lineHeight": 1.25,
      "index": "c062t"
    },
