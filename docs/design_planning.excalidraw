      "version": 3,
      "versionNonce": 930008,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1792242393208,
      "link": null,
      "locked": false,
      "text": "# Proposed ~/.config/abode/config.toml\n[remote]\nurl = \"git@github.com:alex/dotfiles.git\"\nbranch = \"main\"\n\n[sync]\n# Decoded paths relative to this device home:\npaths = [\".config/nvim\", \".config/kitty/kitty.conf\"]\n\nOnly selected paths participate on this device.\nAn empty or absent list means sync nothing.\nA directory selection includes tracked children.\nMerge redundant parent/child selections.\nDiscovery comes from the source tree itself.\nDo not select new remote paths automatically.\nNo ID map or destination override initially.\nKeep config and runtime state out of GitHub.",
      "fontSize": 18,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "# Proposed ~/.config/abode/config.toml\n[remote]\nurl = \"git@github.com:alex/dotfiles.git\"\nbranch = \"main\"\n\n[sync]\n# Decoded paths relative to this device home:\npaths = [\".config/nvim\", \".config/kitty/kitty.conf\"]\n\nOnly selected paths participate on this device.\nAn empty or absent list means sync nothing.\nA directory selection includes tracked children.\nMerge redundant parent/child selections.\nDiscovery comes from the source tree itself.\nDo not select new remote paths automatically.\nNo ID map or destination override initially.\nKeep config and runtime state out of GitHub.",
      "autoResize": false,
      "lineHeight": 1.25
    },
