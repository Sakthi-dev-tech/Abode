      "updated": 1792041357296,
      "link": null,
      "locked": false,
      "text": "GitHub keeps published history.\nConflicts are resolved on the local device.\nPending Git refs survive restarts.",
      "fontSize": 19,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": null,
      "originalText": "GitHub keeps published history.\nConflicts are resolved on the local device.\nPending Git refs survive restarts.",
      "autoResize": false,
      "lineHeight": 1.25
    },
