      "updated": 1792041357296,
      "link": null,
      "locked": false,
      "text": "~/.config/abode/\n  config.toml       # remote + root/path map\n~/.local/share/abode/\n  state.json        # applied revisions/hashes\n                    # apply journal + conflicts\n  repo/             # managed Git clone\n    .git/           # Git objects + pending refs\n    roots/\n      nvim--a81f39c2/\n        metadata.json\n        content/\n          init.lua\n          lua/plugins.lua\n      kitty.conf--c92d170b/\n        metadata.json\n        content/kitty.conf\n\nrepo/ mirrors the tracked GitHub layout.\nConfig and state stay outside the repository.",
      "originalText": "~/.config/abode/\n  config.toml       # remote + root/path map\n~/.local/share/abode/\n  state.json        # applied revisions/hashes\n                    # apply journal + conflicts\n  repo/             # managed Git clone\n    .git/           # Git objects + pending refs\n    roots/\n      nvim--a81f39c2/\n        metadata.json\n        content/\n          init.lua\n          lua/plugins.lua\n      kitty.conf--c92d170b/\n        metadata.json\n        content/kitty.conf\n\nrepo/ mirrors the tracked GitHub layout.\nConfig and state stay outside the repository.",
