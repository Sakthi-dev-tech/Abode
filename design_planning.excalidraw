      "versionNonce": 263953049,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1792041037674,
      "link": null,
      "locked": false,
      "text": "Unmapping only stops device participation.\nA tracked child deletion is reconciled\nagainst its recorded base.\nDelete versus edit becomes a conflict.\nRemote root deletion is an explicit action.",
      "originalText": "Unmapping only stops device participation.\nA tracked child deletion is reconciled\nagainst its recorded base.\nDelete versus edit becomes a conflict.\nRemote root deletion is an explicit action.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": false,
      "lineHeight": 1.25,
