    {
      "id": "abode-local-mapping-body",
      "type": "text",
      "x": 1791.26953125,
      "y": 3730.42578125,
      "width": 530,
      "height": 403.75,
      "angle": 0,
      "strokeColor": "#334155",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 920002,
      "version": 3,
      "versionNonce": 1199380089,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1792042101350,
      "link": null,
      "locked": false,
      "text": "Shared fallback paths in root metadata:\na81f39c2... -> ~/.config/nvim/\nc92d170b... -> ~/.config/kitty/kitty.conf\nExpand ~ using the current device's home.\nA local destination override takes priority.\n\nDirectory: append each child's relative path.\n~/.config/nvim/lua/plugins.lua\n  <-> repo/roots/nvim--a81f39c2/\n        content/lua/plugins.lua\n\nSingle file: use its metadata content entry.\n~/.config/kitty/kitty.conf\n  <-> repo/roots/kitty.conf--c92d170b/\n        content/kitty.conf\n\nSelect roots locally; overrides are optional.\nIDs and fallback paths are shared metadata.\nActual file contents stay as original bytes.",
      "originalText": "Shared fallback paths in root metadata:\na81f39c2... -> ~/.config/nvim/\nc92d170b... -> ~/.config/kitty/kitty.conf\nExpand ~ using the current device's home.\nA local destination override takes priority.\n\nDirectory: append each child's relative path.\n~/.config/nvim/lua/plugins.lua\n  <-> repo/roots/nvim--a81f39c2/\n        content/lua/plugins.lua\n\nSingle file: use its metadata content entry.\n~/.config/kitty/kitty.conf\n  <-> repo/roots/kitty.conf--c92d170b/\n        content/kitty.conf\n\nSelect roots locally; overrides are optional.\nIDs and fallback paths are shared metadata.\nActual file contents stay as original bytes.",
      "fontSize": 17,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": false,
      "lineHeight": 1.25,
      "index": "c062z"
    },
