      "isDeleted": false,
      "boundElements": [],
      "updated": 1792033449021,
      "link": null,
      "locked": false,
      "text": "Only manage the selected root and tracked\ndescendants. Detect overlapping roots.\nA missing or unreadable root pauses sync.\nNever treat an unavailable root as deletion.\nDo not overwrite unrelated local files.",
      "originalText": "Only manage the selected root and tracked\ndescendants. Detect overlapping roots.\nA missing or unreadable root pauses sync.\nNever treat an unavailable root as deletion.\nDo not overwrite unrelated local files.",
