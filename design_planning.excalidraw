      "link": null,
      "locked": false,
      "text": "metadata.json: ID + portable fallback path",
      "fontSize": 22,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "metadata.json: ID + portable fallback path",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "repo-guide-metadata-body",
      "type": "text",
      "x": 2900,
      "y": 1025,
      "width": 640,
      "height": 552.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "c910",
      "roundness": null,
      "seed": 930011,
      "version": 2,
      "versionNonce": 930011,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1792042101350,
      "link": null,
      "locked": false,
      "text": "// nvim root (directory)\n{\n  \"format_version\": 1,\n  \"id\": \"a81f39c2-7b4e-4e8a-9c10-2d38f65a9041\",\n  \"kind\": \"directory\",\n  \"display_name\": \"nvim\",\n  \"fallback_path\": \"~/.config/nvim\",\n  \"entries\": {\n    \"scripts/setup.sh\": { \"executable\": true }\n  }\n}\n\n// kitty.conf root (single file)\n{\n  \"format_version\": 1,\n  \"id\": \"c92d170b-62ab-45db-8e70-f24a6159c302\",\n  \"kind\": \"file\",\n  \"display_name\": \"kitty.conf\",\n  \"fallback_path\": \"~/.config/kitty/kitty.conf\",\n  \"content_entry\": \"kitty.conf\"\n}\n\nEach object is a separate shared metadata.json.\nStore ~/ literally; expand it only on the device.\nDirectory fallback -> folder; file fallback -> file.\nChildren inherit the root path + relative path.",
      "fontSize": 17,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "// nvim root (directory)\n{\n  \"format_version\": 1,\n  \"id\": \"a81f39c2-7b4e-4e8a-9c10-2d38f65a9041\",\n  \"kind\": \"directory\",\n  \"display_name\": \"nvim\",\n  \"fallback_path\": \"~/.config/nvim\",\n  \"entries\": {\n    \"scripts/setup.sh\": { \"executable\": true }\n  }\n}\n\n// kitty.conf root (single file)\n{\n  \"format_version\": 1,\n  \"id\": \"c92d170b-62ab-45db-8e70-f24a6159c302\",\n  \"kind\": \"file\",\n  \"display_name\": \"kitty.conf\",\n  \"fallback_path\": \"~/.config/kitty/kitty.conf\",\n  \"content_entry\": \"kitty.conf\"\n}\n\nEach object is a separate shared metadata.json.\nStore ~/ literally; expand it only on the device.\nDirectory fallback -> folder; file fallback -> file.\nChildren inherit the root path + relative path.",
      "autoResize": false,
      "lineHeight": 1.25
    },
