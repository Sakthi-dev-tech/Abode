    },
    {
      "id": "repo-guide-device-config-body",
      "type": "text",
      "x": 3620,
      "y": 335,
      "width": 640,
      "height": 450,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "c907",
      "roundness": null,
      "seed": 930008,
      "version": 2,
      "versionNonce": 930008,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1792042101350,
      "link": null,
      "locked": false,
      "text": "# ~/.config/abode/config.toml\n[remote]\nurl = \"git@github.com:alex/dotfiles.git\"\nbranch = \"main\"\n\n[roots.\"a81f39c2-7b4e-4e8a-9c10-2d38f65a9041\"]\nenabled = true\n# No destination: use metadata.fallback_path.\n\n[roots.\"c92d170b-62ab-45db-8e70-f24a6159c302\"]\nenabled = true\n# Optional override on this device only:\ndestination = \"~/configs/kitty/kitty.conf\"\n\nSelect roots locally; destination is optional.\nAbsent or disabled root selection means skip.\nExpand ~/ in both fallback and override paths.\nLocal overrides may also be absolute paths.\nFallback paths stay shared in root metadata.\nKeep resolved device-specific paths out of GitHub.",
      "fontSize": 18,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "# ~/.config/abode/config.toml\n[remote]\nurl = \"git@github.com:alex/dotfiles.git\"\nbranch = \"main\"\n\n[roots.\"a81f39c2-7b4e-4e8a-9c10-2d38f65a9041\"]\nenabled = true\n# No destination: use metadata.fallback_path.\n\n[roots.\"c92d170b-62ab-45db-8e70-f24a6159c302\"]\nenabled = true\n# Optional override on this device only:\ndestination = \"~/configs/kitty/kitty.conf\"\n\nSelect roots locally; destination is optional.\nAbsent or disabled root selection means skip.\nExpand ~/ in both fallback and override paths.\nLocal overrides may also be absolute paths.\nFallback paths stay shared in root metadata.\nKeep resolved device-specific paths out of GitHub.",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "repo-guide-metadata-card",
